# Native installation settings. Only uv is required; Docker is not required.
BUGLENS_HOST=127.0.0.1
BUGLENS_PORT=8000
BUGLENS_WEB_HOST=127.0.0.1
BUGLENS_WEB_PORT=8080
BUGLENS_TRACING=true
BUGLENS_CORS_ORIGIN=
BUGLENS_ADMIN_TOKEN=
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Optional: path to an extracted frontend-static release. Defaults to frontend/dist.
# BUGLENS_FRONTEND_SOURCE=/opt/buglens/frontend
