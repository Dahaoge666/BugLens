# Pin released images in production. Local development can override these with
# images built from the backend and frontend projects.
BUGLENS_VERSION=0.1.0
BUGLENS_BACKEND_IMAGE=ghcr.io/dahaoge666/buglens-backend:${BUGLENS_VERSION}
BUGLENS_FRONTEND_IMAGE=ghcr.io/dahaoge666/buglens-frontend:${BUGLENS_VERSION}
BUGLENS_PORT=8000
BUGLENS_WEB_PORT=8080
BUGLENS_DATA_DIR=./data
BUGLENS_CORS_ORIGIN=
BUGLENS_ADMIN_TOKEN=
OPENAI_API_KEY=
