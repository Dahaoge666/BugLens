# Required for real model calls
OPENAI_API_KEY=
OPENAI_BASE_URL=

# CLI and SDK session configuration
BUGLENS_SESSION_DB=data/buglens.db
BUGLENS_ENVIRONMENTS_CONFIG=
BUGLENS_TRACING=true
# HTTP API binding
BUGLENS_HOST=127.0.0.1
BUGLENS_PORT=8000
# Full mode serves the frontend and proxies /v1 to this API.
BUGLENS_WEB_HOST=127.0.0.1
BUGLENS_WEB_PORT=8080
# Optional security settings
BUGLENS_CORS_ORIGIN=
BUGLENS_ADMIN_TOKEN=
# Required only when an explicitly registered SDK tool uses needs_approval=true.
# Use the same secret in every process that must resume approvals.
BUGLENS_RUN_STATE_KEY=
# BUGLENS_PROMPT_CONFIG=config/tenant_prompts.yaml
